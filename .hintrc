{
  "extends": [
    "development"
  ],
  "hints": {
    "axe/text-alternatives": "off",
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "text-size-adjust",
          "scrollbar-width",
          "scrollbar-color"
        ]
      }
    ],
    "compat-api/html": "default",
    "no-inline-styles": "error"
  }
}
